#!/usr/bin/env bash
# ============================================================
# build_logged.sh - Runs Ninja and logs output to build.log
# Generated by CMake - do not edit manually
# ============================================================

BUILD_DIR="@CMAKE_BINARY_DIR@"
LOG_FILE="$BUILD_DIR/build.log"

echo "[build_logged] Building project..."
echo "[build_logged] Build directory: $BUILD_DIR"
echo "[build_logged] Log file:        $LOG_FILE"
echo

# Header
{
    echo "============================================================"
    echo "Build started at $(date '+%Y-%m-%d %H:%M:%S')"
    echo "============================================================"
} > "$LOG_FILE"

# Build with tee (output to console and file simultaneously)
ninja -C "$BUILD_DIR" 2>&1 | tee -a "$LOG_FILE"
EXIT_CODE=${PIPESTATUS[0]}

# Footer
{
    echo
    echo "============================================================"
    echo "Build finished at $(date '+%Y-%m-%d %H:%M:%S') (exit code $EXIT_CODE)"
    echo "============================================================"
} >> "$LOG_FILE"

echo
echo "[build_logged] Done. Exit code: $EXIT_CODE"
exit $EXIT_CODE
