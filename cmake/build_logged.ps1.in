# ============================================================
# build_logged.ps1 - Runs Ninja and logs output to build.log
# Generated by CMake - do not edit manually
# ============================================================

$BuildDir = "@CMAKE_BINARY_DIR@"
$LogFile  = Join-Path $BuildDir "build.log"

Write-Host "[build_logged] Building project..."
Write-Host "[build_logged] Build directory: $BuildDir"
Write-Host "[build_logged] Log file:        $LogFile"
Write-Host

# Header
@"
============================================================
Build started at $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
============================================================
"@ | Out-File -FilePath $LogFile -Encoding utf8

# Build with tee (output to console and file)
ninja -C $BuildDir 2>&1 | Tee-Object -FilePath $LogFile -Append
$ExitCode = $LASTEXITCODE

# Footer
@"

============================================================
Build finished at $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') (exit code $ExitCode)
============================================================
"@ | Add-Content -Path $LogFile

Write-Host
Write-Host "[build_logged] Done. Exit code: $ExitCode"
exit $ExitCode
