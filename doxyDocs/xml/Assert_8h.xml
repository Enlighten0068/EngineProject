    <sectiondef kind="define">
      <memberdef kind="define" id="Assert_8h_1a8cd446f746bfa7d25787eb94290c900d" prot="public" static="no">
        <name>ENGINE_ASSERT</name>
        <param><defname>condition</defname></param>
        <param><defname>message</defname></param>
        <initializer>do{ \
    if(!(condition)){ \
        <ref refid="classLog_1a860a6724a65c95001e3617ac6ae04e28" kindref="member">Log::Error</ref>(std::format(&quot;Assertion Failed: {}\nFile: {}\n Line: {}&quot;, message, __FILE__, __LINE__)); \
        std::abort(); \
    } \
} while(false)</initializer>
        <briefdescription>
<para>Asserts a condition and aborts the program if it fails. </para>
        </briefdescription>
        <detaileddescription>
<para>If the condition evaluates to false, logs an error message with the file name and line number, then terminates the program with std::abort().</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>condition</parametername>
</parameternamelist>
<parameterdescription>
<para>The condition to evaluate. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>message</parametername>
</parameternamelist>
<parameterdescription>
<para>The error message to log if the condition fails.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="note"><para>Should be used only in debug builds. </para>
</simplesect>
<simplesect kind="see"><para><ref refid="classLog_1a860a6724a65c95001e3617ac6ae04e28" kindref="member">Log::Error</ref> </para>
</simplesect>
</para>
